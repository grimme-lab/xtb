@PACKAGE_INIT@

set("@PROJECT_NAME@_WITH_OpenMP" @WITH_OpenMP@)
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

if(NOT TARGET "@PROJECT_NAME@::@PROJECT_NAME@")
  include(CMakeFindDependencyMacro)

  if(@WITH_OpenMP@ AND NOT TARGET "OpenMP::OpenMP_Fortran")
    find_dependency("OpenMP" COMPONENTS Fortran)
  endif()

  if(NOT TARGET "mctc-lib::mctc-lib")
    find_dependency("mctc-lib" REQUIRED)
  endif()

  if(@WITH_TBLITE@ AND NOT TARGET "tblite::tblite")
    find_dependency("tblite" REQUIRED)
  endif()

  if(@WITH_CPCMX@ AND NOT TARGET "cpcmx::cpcmx")
    find_dependency("cpcmx" REQUIRED)
  endif()

  if(NOT LAPACK_FOUND)
    find_dependency("LAPACK" REQUIRED)
  endif()

  include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@-targets.cmake")
endif()
